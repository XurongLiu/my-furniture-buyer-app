DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Source catalog for the one-off import script (scripts/import-catalog.mjs).
MONGODB_URI="mongodb+srv://user:password@cluster.example.mongodb.net/catalog"

# Day 1 Participant Guide's Product Search / Order / Balance API.
HACKATHON_API_BASE_URL="https://your-event-base-url"
HACKATHON_USER_ID="replace-with-your-user-id"
HACKATHON_API_KEY="replace-with-your-api-key"

# Azure OpenAI (GPT-5 mini) — powers the shopping assistant agent.
AZURE_OPENAI_ENDPOINT="https://your-resource.api.cognitive.microsoft.com/"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
AZURE_OPENAI_DEPLOYMENT="gpt-5-mini"
AZURE_OPENAI_API_KEY="replace-with-your-azure-openai-key"
