generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  budget       Float    @default(1000)
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Product {
  id            String      @id @default(cuid())
  externalId    String?     @unique // source catalog's own id, e.g. IKEA item_id; null for hand-seeded items
  name          String
  description   String
  price         Float
  category      String
  emoji         String? // fallback placeholder art, used only when no real image exists
  imageData     String? // base64-encoded image bytes, served via /api/products/[id]/image
  imageMimeType String?
  sourceUrl     String? // link back to the original catalog listing, if any
  orderItems    OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  total           Float
  externalOrderId String? // the real order_id from the hackathon API
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
}
